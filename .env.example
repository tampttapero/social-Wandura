# ==========================================================
# Social Wandura - cau hinh. Chep thanh .env (hoac chay scripts\setup.ps1).
# KHONG commit file .env len GitHub.
# ==========================================================

# ---- Co ban ----
POSTIZ_VERSION=latest
APP_PORT=4007
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# Chuoi ngau nhien, setup.ps1 se tu tao
JWT_SECRET=change-me
POSTGRES_PASSWORD=change-me

# Team: de 'false' de dong nghiep tu dang ky; sau khi moi du nguoi thi doi thanh 'true'
DISABLE_REGISTRATION=false
API_LIMIT=30

# ---- Facebook Page + Instagram (Business, qua Facebook) ----
# Callback: {FRONTEND_URL}/integrations/social/facebook  va  /integrations/social/instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- Instagram Standalone (khong can Facebook Page) ----
# Callback: {FRONTEND_URL}/integrations/social/instagram-standalone
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- X (Twitter) ----
# Callback: {FRONTEND_URL}/integrations/social/x
X_API_KEY=
X_API_SECRET=

# ---- Discord ----
# Callback: {FRONTEND_URL}/integrations/social/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=

# ---- YouTube (Google Cloud OAuth) ----
# Callback: {FRONTEND_URL}/integrations/social/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---- AI viet noi dung (caption, hashtag, anh) ----
OPENAI_API_KEY=

# ---- Tat thanh toan Stripe (dung noi bo) ----
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=
